# Database
DATABASE_URL="mysql://user:password@localhost:3307/TaskManagerDB"

# Auth — use a long random string in production (min 32 chars)
JWT_SECRET="your-jwt-secret-change-in-production"

# Resend Email (https://resend.com)
RESEND_API_KEY="re_your_key_here"
EMAIL_FROM="Task Manager <onboarding@resend.dev>"

# Frontend URL (used in email links)
APP_URL="http://localhost:5173"

# Password reset token expiry in minutes (default: 30)
PASSWORD_RESET_EXPIRY_MINUTES=30

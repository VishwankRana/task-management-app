# =============================================================================
# Local development
# =============================================================================
DATABASE_URL="mysql://user:password@localhost:3307/TaskManagerDB"
NODE_ENV="development"
PORT=3000

# Auth — min 32 characters (Render can auto-generate JWT_SECRET)
JWT_SECRET="your-jwt-secret-change-in-production-use-32plus-chars"

# Frontend URL (email links + default CORS origin)
APP_URL="http://localhost:5173"

# Resend Email (https://resend.com) — optional for password reset emails
RESEND_API_KEY="re_your_key_here"
EMAIL_FROM="Task Manager <onboarding@resend.dev>"
PASSWORD_RESET_EXPIRY_MINUTES=30

# Local frontend API target (default: http://localhost:3000)
# VITE_API_URL="http://localhost:3000"

# =============================================================================
# Render (API backend) — set in Render dashboard or render.yaml
# =============================================================================
# NODE_ENV=production
# PORT=10000                    # Render sets PORT automatically
# COOKIE_CROSS_SITE=true        # Required for Vercel frontend + Render API
# DATABASE_URL=mysql://...      # External MySQL (Aiven, Railway, etc.)
# JWT_SECRET=<64-char-random>
# APP_URL=https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app-*.vercel.app
# CORS_ALLOW_VERCEL=true         # Allow all *.vercel.app preview deployments

# =============================================================================
# Vercel (frontend) — set in Vercel project Environment Variables
# =============================================================================
# VITE_API_URL=https://task-manager-api.onrender.com
